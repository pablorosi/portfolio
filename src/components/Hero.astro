---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import HeroTechMarquee from './HeroTechMarquee.astro';
import TermButton from './terminal/TermButton.astro';

interface Props {
	name: string;
	greeting?: string;
	role?: string;
	description: string;
	descriptionFocus?: string;
	photo: ImageMetadata;
	docsUrl: string;
	social: {
		github: string;
		linkedin: string;
		email: string;
	};
}

const {
	name,
	greeting = 'HI THERE',
	role = 'Computer Science Student',
	description,
	descriptionFocus,
	photo,
	docsUrl,
	social,
} = Astro.props;
---

<header
	class="relative mx-auto flex w-full max-w-[1120px] flex-col justify-start px-8 pt-12 pb-10 max-[720px]:px-5 max-[720px]:pt-10 max-[720px]:pb-8"
	data-reveal="up"
>
	<div class="relative z-[1] w-full text-left">
		<div class="mb-8 flex w-full items-center gap-6 max-[720px]:gap-4">
			<Picture
				src={photo}
				alt={name}
				loading="eager"
				fetchpriority="high"
				width={240}
				height={240}
				sizes="(max-width: 720px) 96px, 120px"
				formats={['avif', 'webp']}
				class="block h-[120px] w-[120px] shrink-0 rounded-full object-cover shadow-[0_0_0_3px_color-mix(in_srgb,var(--hero-image-frame-color)_55%,transparent),0_0_0_6px_color-mix(in_srgb,var(--color-gray-6)_70%,transparent),0_8px_24px_rgba(0,0,0,0.35)] max-[720px]:h-[96px] max-[720px]:w-[96px]"
			/>
			<div class="min-w-0 flex-1">
				<p class="mb-2 font-['JetBrains_Mono',monospace] text-xs font-bold tracking-[0.2em] text-[var(--color-accent)] uppercase max-[720px]:mb-1.5 max-[720px]:text-[0.65rem] max-[720px]:tracking-[0.15em]">
					{greeting}
				</p>
				<h1 class="hero-name m-0 text-[clamp(2.75rem,5.5vw,4.25rem)] leading-[1.08] font-bold tracking-[-0.03em] max-[720px]:text-[clamp(2.65rem,9vw,3.25rem)] max-[720px]:leading-[1.06]">
					{name}
				</h1>
				<p class="mb-0 mt-2 text-sm font-medium text-[var(--color-gray-2)] md:text-base max-[720px]:mt-1.5 max-[720px]:text-xs">
					{role}
				</p>
			</div>
		</div>

		<p class="mb-2 mt-0 max-w-2xl text-base leading-relaxed text-[var(--color-gray-2)] md:text-lg max-[720px]:text-sm">
			{description}
		</p>
		{descriptionFocus && (
			<p class="mb-8 mt-0 max-w-2xl text-sm leading-relaxed text-[var(--color-gray-3)] md:text-base max-[720px]:text-xs">
				{descriptionFocus}
			</p>
		)}
		{!descriptionFocus && <div class="mb-8" />}

		<div class="mb-0 flex w-full flex-wrap items-center gap-x-6 gap-y-4">
			<div class="flex items-center gap-4">
				<a
					href={social.github}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex rounded-lg p-2 text-[var(--color-gray-3)] transition-colors duration-200 hover:text-[var(--color-accent)]"
					aria-label="GitHub"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
						<path d="M9 18c-4.51 2-5-2-7-2" />
					</svg>
				</a>
				<a
					href={social.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex rounded-lg p-2 text-[var(--color-gray-3)] transition-colors duration-200 hover:text-[var(--color-accent)]"
					aria-label="LinkedIn"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
						<rect width="4" height="12" x="2" y="9" />
						<circle cx="4" cy="4" r="2" />
					</svg>
				</a>
				<a
					href={social.email}
					class="inline-flex rounded-lg p-2 text-[var(--color-gray-3)] transition-colors duration-200 hover:text-[var(--color-accent)]"
					aria-label="Email"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect width="20" height="16" x="2" y="4" rx="2" />
						<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
					</svg>
				</a>
			</div>

			<TermButton
				href={docsUrl}
				label=">_ view_docs"
				ariaLabel="View my docs"
				external
				class="max-[480px]:px-5 max-[480px]:py-2 max-[480px]:text-sm"
			/>
		</div>

		<HeroTechMarquee />
	</div>
</header>

<style>
	.hero-name {
		display: inline-block;
		background: linear-gradient(90deg, var(--color-white), var(--color-accent) 45%, var(--color-white));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	:root[data-theme='light'] .hero-name {
		background: linear-gradient(90deg, var(--color-gray-1), var(--color-accent) 45%, var(--color-gray-1));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
</style>
