---
// src/components/Terminal.astro
---

<div class="terminal-wrapper">
  <div class="terminal-header">
    <div class="terminal-buttons">
      <span class="terminal-btn close"></span>
      <span class="terminal-btn minimize"></span>
      <span class="terminal-btn maximize"></span>
    </div>
    <div class="terminal-title">pablo@portfolio: ~</div>
  </div>
  
  <div class="terminal-window" id="terminal-window">
    <div id="terminal-history">
      <p class="sys-msg">Session started: {new Date().toLocaleDateString()}</p>
      <p class="sys-msg">Type <span class="highlight">help</span> to explore my profile.</p>
    </div>
    
    <div class="input-line">
      <span class="prompt" id="current-path">pablo@portfolio:~$</span>
      <input type="text" id="terminal-input" autocomplete="off" spellcheck="false" />
    </div>
  </div>
</div>

<style>
  .terminal-wrapper {
    --terminal-bg: #151515;
    --terminal-header-bg: #1c1c1c;
    --terminal-border: #2a2a2a;
    --terminal-text: #e0e2e8;
    --terminal-title: #888b97;
    --terminal-muted: #7a7d8a;
    --terminal-input: #fff;
    background-color: var(--terminal-bg);
    border-radius: 8px;
    border: 1px solid var(--terminal-border);
    font-family: var(--sl-font-mono), monospace;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
  }

  :global(:root[data-theme='light']) .terminal-wrapper {
    --terminal-bg: #f5f8fc;
    --terminal-header-bg: #e6eaf1;
    --terminal-border: #c2ccd8;
    --terminal-text: #1b2739;
    --terminal-title: #5e6d84;
    --terminal-muted: #5e6d84;
    --terminal-input: #131921;
    box-shadow: 0 8px 24px rgba(27, 39, 57, 0.14);
  }

  .terminal-window {
    padding: 1.5rem; 
    min-height: 500px;
    max-height: 500px;
    overflow-y: auto; 
    color: var(--terminal-text);
    font-size: 0.9rem; 
  }

  .terminal-window::-webkit-scrollbar {
    width: 10px;
  }

  .terminal-window::-webkit-scrollbar-track {
    background: #111111;
  }

  .terminal-window::-webkit-scrollbar-thumb {
    background: #333333;
    border-radius: 6px;
    border: 2px solid #111111;
  }

  .terminal-window::-webkit-scrollbar-thumb:hover {
    background: #444444;
  }
  .terminal-header { background-color: var(--terminal-header-bg); padding: 0.5rem 1rem; display: flex; align-items: center; border-bottom: 1px solid var(--terminal-border); }
  .terminal-buttons { display: flex; gap: 6px; }
  .terminal-btn { width: 12px; height: 12px; border-radius: 50%; display: block; padding: 0; margin: 0; }
  .close { background-color: #ff5f56; }
  .minimize { background-color: #ffbd2e; }
  .maximize { background-color: #27c93f; }
  .terminal-title { color: var(--terminal-title); font-size: 0.8rem; margin: 0 auto; padding-right: 40px; }
  .sys-msg { margin: 0 0 0.5rem 0; color: var(--terminal-muted); }
  .highlight { color: #27c93f; font-weight: bold; }
  .folder { color: #5da9f6; font-weight: bold; }
  .error { color: #ff5f56; }
  .input-line { display: flex; align-items: center; margin-top: 0.5rem; }
  .prompt { color: #27c93f; margin-right: 0.5rem; white-space: nowrap; }
  #terminal-input { background: transparent; border: none; color: var(--terminal-input); font-family: inherit; font-size: inherit; flex-grow: 1; outline: none; }

  .fetch-output {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
    margin: 0.25rem 0 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.15;
  }

  .fetch-art pre {
    margin: 0;
    color: #27c93f;
    font-family: inherit;
    font-size: inherit;
    line-height: 1.1;
    white-space: pre;
  }

  .fetch-info {
    min-width: 14rem;
  }

  @media (max-width: 600px) {
    .fetch-output {
      flex-direction: column;
    }
  }
</style>

<script>
  import { renderNeofetch, WHOAMI } from '../lib/terminal/neofetch';

  // TypeScript Interfaces for the Virtual File System
  type FileEntry = {
    kind: 'html' | 'text' | 'link';
    value: string;
  };

  interface Directory {
    [fileName: string]: FileEntry | 'DIR';
  }

  interface FileSystem {
    [dirName: string]: Directory;
  }

  const fileSystem: FileSystem = {
    root: {
      'certs.txt': {
        kind: 'html',
        value: [
'<span style="color: #e6e6e6; font-size: 1.2rem; font-weight: bold;">🎓 Certifications</span>',
        '<span style="color: #aaa;">Professional certification roadmap focused on enterprise networking, cloud infrastructure, and NetDevOps.</span>',
        '<br>',
        '<span style="color: #e6e6e6; font-weight: bold;">ACTIVE CERTIFICATION TRACKS</span>',
        '<span style="color: #555;">--------------------------------------------------</span>',
        '<span style="color: #27c93f; font-weight: bold;">CCNA</span> <span style="color: #888;">(Cisco &middot; Completed)</span>',
        'Status:   <span style="color: #27c93f; border: 1px solid #27c93f; padding: 0 4px; border-radius: 3px; font-size: 0.8rem;">Completed</span>',
        'Verify:   <a href="https://www.credly.com/badges/53b76bed-1afd-4323-b04a-0df1381cb943/public_url" style="color: #5da9f6;" target="_blank">credly.com/badge</a>',
        '<br>',
        '<span style="color: #27c93f; font-weight: bold;">AZ-104</span> <span style="color: #888;">(Microsoft &middot; Target: 2026)</span>',
        'Status:   <span style="color: #bd93f9; border: 1px solid #bd93f9; padding: 0 4px; border-radius: 3px; font-size: 0.8rem;">In Progress</span>',
        'Progress: <span style="color: #5da9f6;">[██░░░░░░░░░░░░░░░░░░]</span> ~10%',
        '<span style="color: #555;">--------------------------------------------------</span>'
      ].join('<br>')
      },
      'skills.txt': {
        kind: 'html',
        value: [
        '<span style="color: #e6e6e6; font-size: 1.1rem; font-weight: bold;">&lt;&gt; Skills &amp; Expertise</span>',
        '<span style="color: #aaa; font-size: 0.85rem;">Core engineering competencies across network architecture, bare-metal hypervisors, and infrastructure automation.</span>',
        '<br>',
        '<span style="color: #5da9f6;">◉</span> <span style="color: #e6e6e6; font-weight: bold;">Enterprise Networking</span>',
        '&nbsp;&nbsp;&nbsp;<span style="color: #d8b4fe; border: 1px solid #6b21a8; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">Cisco IOS</span> <span style="color: #d8b4fe; border: 1px solid #6b21a8; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">OSPF</span> <span style="color: #d8b4fe; border: 1px solid #6b21a8; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">Static Routing</span> <span style="color: #d8b4fe; border: 1px solid #6b21a8; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">VLANs</span> <span style="color: #d8b4fe; border: 1px solid #6b21a8; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">STP</span> <span style="color: #d8b4fe; border: 1px solid #6b21a8; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">LACP</span> <span style="color: #fca5a5; border: 1px solid #7f1d1d; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">IPv4/IPv6 Subnetting</span> <span style="color: #fca5a5; border: 1px solid #7f1d1d; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">ACLs</span>',
        '<span style="color: #5da9f6;">◉</span> <span style="color: #e6e6e6; font-weight: bold;">Infrastructure Automation</span>',
        '&nbsp;&nbsp;&nbsp;<span style="color: #86efac; border: 1px solid #14532d; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">Ansible</span> <span style="color: #86efac; border: 1px solid #14532d; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">Terraform</span> <span style="color: #fde047; border: 1px solid #713f12; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">Python (Network Automation)</span>',
        '<span style="color: #5da9f6;">◉</span> <span style="color: #e6e6e6; font-weight: bold;">Cloud &amp; Virtualization</span>',
        '&nbsp;&nbsp;&nbsp;<span style="color: #a5b4fc; border: 1px solid #3b426e; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">Proxmox VE</span> <span style="color: #a5b4fc; border: 1px solid #3b426e; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">EVE-NG</span> <span style="color: #fca5a5; border: 1px solid #7f1d1d; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">Microsoft Azure (AZ-104)</span> <span style="color: #a5b4fc; border: 1px solid #3b426e; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">Docker</span>',
        '<span style="color: #5da9f6;">◉</span> <span style="color: #e6e6e6; font-weight: bold;">Linux Systems</span>',
        '&nbsp;&nbsp;&nbsp;<span style="color: #a5b4fc; border: 1px solid #3b426e; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">RHEL</span> <span style="color: #a5b4fc; border: 1px solid #3b426e; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">Debian</span> <span style="color: #fca5a5; border: 1px solid #7f1d1d; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">WireGuard VPN</span> <span style="color: #fca5a5; border: 1px solid #7f1d1d; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">Secure Routing</span> <span style="color: #86efac; border: 1px solid #14532d; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">Nginx (Reverse Proxy)</span> <span style="color: #fde047; border: 1px solid #713f12; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">TLS/SSL</span> <span style="color: #fde047; border: 1px solid #713f12; padding: 1px 6px; border-radius: 8px; font-size: 0.75rem;">DNS</span>',
        '<br>',
      ].join('<br>')
      },
      'projects': 'DIR',
      'contact': 'DIR'
    },
    projects: {
      'cloud-infrastructure.sh': {
        kind: 'link',
        value: 'https://docs.pablorosi.dev/cloud-infrastructure/',
      },
      'enterprise-homelab.sh': {
        kind: 'link',
        value: 'https://docs.pablorosi.dev/enterprise-homelab/',
      },
      'readme.md': {
        kind: 'text',
        value: [
          'Technical Projects',
          '------------------',
          './cloud-infrastructure.sh   Cloud Infrastructure',
          './enterprise-homelab.sh       Enterprise Homelab',
          '',
          'Run ./filename.sh inside projects/ to open documentation.',
        ].join('\n'),
      },
    },
    contact: {
      'Email.sh': { kind: 'link', value: 'mailto:hello@pablorosi.dev' },
      'Linkedin.sh': { kind: 'link', value: 'https://www.linkedin.com/in/pablorosi/' },
      'GitHub.sh': { kind: 'link', value: 'https://github.com/pablorosi' }
    },
  };

  const PROMPT_USER = 'pablo';
  const PROMPT_HOST = 'portfolio';

  function formatPrompt(pathDisplay: string): string {
    return `${PROMPT_USER}@${PROMPT_HOST}:${pathDisplay}$`;
  }

  let currentDir = 'root';
  let meltdownInProgress = false;
  const commandHistory: string[] = [];
  let historyIndex = 0;
  let savedDraft = '';
  const input = document.getElementById('terminal-input') as HTMLInputElement;
  const history = document.getElementById('terminal-history');
  const windowNode = document.getElementById('terminal-window');
  const pathLabel = document.getElementById('current-path');

  function scrollToBottom() {
    if (windowNode) windowNode.scrollTop = windowNode.scrollHeight;
  }

  function openTerminalLink(url: string, action: 'navigate' | 'open') {
    if (url.startsWith('mailto:') || action === 'navigate') {
      window.location.href = url;
      return;
    }
    window.open(url, '_blank', 'noopener,noreferrer');
  }

  function parseCommandInput(fullCommand: string): { cmd: string; args: string[] } {
    const parts = fullCommand.trim().split(/\s+/).filter(Boolean);
    const [cmd = '', ...args] = parts;
    return { cmd, args };
  }

  function printExtraOperandError(command: string, operand: string) {
    printTextLine(`${command}: extra operand '${operand}'`, 'error');
  }

  function printFileEntry(fileName: string, entry: FileEntry) {
    if (entry.kind === 'html') {
      printLine(entry.value);
      return;
    }
    printTextLine(entry.value);
  }
  
// @warning: Only use this for internal/hardcoded safe HTML. Avoid using with untrusted content to prevent XSS vulnerabilities.
  function printLine(html: string) {
    if (history) {
      const p = document.createElement('p');
      p.style.margin = '0.2rem 0';
      p.innerHTML = html;
      history.appendChild(p);
      scrollToBottom();
    }
  }

  function printTextLine(text: string, className?: string) {
    if (history) {
      const p = document.createElement('p');
      p.style.margin = '0.2rem 0';
      if (className) p.className = className;
      p.textContent = text;
      history.appendChild(p);
      scrollToBottom();
    }
  }

  function printCommandLine(promptText: string, commandText: string) {
    if (history) {
      const p = document.createElement('p');
      p.style.margin = '0.2rem 0';
      const promptSpan = document.createElement('span');
      promptSpan.className = 'prompt';
      promptSpan.textContent = promptText;
      p.appendChild(promptSpan);
      p.appendChild(document.createTextNode(` ${commandText}`));
      history.appendChild(p);
      scrollToBottom();
    }
  }

  function isMassDirectoryDeleteCommand(command: string): boolean {
    const normalized = command.trim().replace(/\s+/g, ' ').toLowerCase();
    return /^rm\s+-[a-z]*r[a-z]*\s+.*(\/\*|\*|\*\/|\/)\s*$/.test(normalized);
  }
  function runFakeMeltdown() {
    if (meltdownInProgress) {
      printLine('<span style="color: #ffbd2e; font-weight: bold;">[WARN]</span> <span style="color: #e6e6e6;">meltdown already in progress... hold on to your keyboard.</span>');
      scrollToBottom();
      return;
    }

    meltdownInProgress = true;
    
    // Immediate lines (Red)
    printLine('<span style="color: #ff5f56; font-weight: bold;">[CRITICAL]</span> <span style="color: #e6e6e6;">kernel panic: /dev/reality not found</span>');
    printLine('<span style="color: #ff5f56; font-weight: bold;">[CRITICAL]</span> <span style="color: #e6e6e6;">filesystem corruption detected</span>');

    // The sequence with dynamic colors
    const sequence = [
      { prefix: '[EMERGENCY]', text: ' shutting down all services in 3...', color: '#ffbd2e' },
      { prefix: '[EMERGENCY]', text: ' 2...', color: '#ffbd2e' },
      { prefix: '[EMERGENCY]', text: ' 1...', color: '#ffbd2e' },
      { prefix: '[FATAL]', text: ' coffee daemon crashed. rollback unavailable.', color: '#ff5f56' },
      { prefix: '[SYSTEM]', text: ' just kidding. this terminal is immortal. Nice Try! :)', color: '#27c93f' }
    ];

    sequence.forEach((line, index) => {
      setTimeout(() => {
        // Formats the prefix in bold color, and the text in standard gray
        printLine(`<span style="color: ${line.color}; font-weight: bold;">${line.prefix}</span><span style="color: #e6e6e6;">${line.text}</span>`);
        
        scrollToBottom();
        if (index === sequence.length - 1) meltdownInProgress = false;
      }, 450 * (index + 1));
    });
  }

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (commandHistory.length === 0) return;

      if (historyIndex === commandHistory.length) {
        savedDraft = input.value;
      }

      if (historyIndex > 0) {
        historyIndex--;
        input.value = commandHistory[historyIndex];
      }
      return;
    }

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (commandHistory.length === 0) return;

      if (historyIndex < commandHistory.length - 1) {
        historyIndex++;
        input.value = commandHistory[historyIndex];
      } else if (historyIndex === commandHistory.length - 1) {
        historyIndex = commandHistory.length;
        input.value = savedDraft;
      }
      return;
    }

    if (e.key === 'Enter') {
      const fullCommand = input.value.trim();
      input.value = '';
      if (!fullCommand) {
        historyIndex = commandHistory.length;
        savedDraft = '';
        return;
      }

      commandHistory.push(fullCommand);
      historyIndex = commandHistory.length;
      savedDraft = '';

      if (meltdownInProgress) {
        printTextLine('[LOCKED] command ignored while system meltdown is active...', 'error');
        scrollToBottom();
        return;
      }

      const pathDisplay = currentDir === 'root' ? '~' : `~/${currentDir}`;
      printCommandLine(formatPrompt(pathDisplay), fullCommand);

      if (isMassDirectoryDeleteCommand(fullCommand)) {
        runFakeMeltdown();
        return;
      }

      const { cmd, args } = parseCommandInput(fullCommand);
      const target = args[0];
      const normalizedTarget = target?.replace(/\/+$/g, '');
      const cmdLower = cmd.toLowerCase();

      switch (cmdLower) {
        case 'help':
          if (args.length > 0) {
            printExtraOperandError('help', args[0]);
            break;
          }
          printLine('<br><span class="highlight">Available commands:</span>');
          printLine('<span style="display:inline-block; width:100px; color:#5da9f6; font-weight:bold;">ls</span> <span style="color:#aaa;">List directory contents</span>');
          printLine('<span style="display:inline-block; width:100px; color:#5da9f6; font-weight:bold;">cd [dir]</span> <span style="color:#aaa;">Change the current directory</span>');
          printLine('<span style="display:inline-block; width:100px; color:#5da9f6; font-weight:bold;">cat [file]</span> <span style="color:#aaa;">Read the contents of a text file</span>');
          printLine('<span style="display:inline-block; width:100px; color:#5da9f6; font-weight:bold;">./[script]</span> <span style="color:#aaa;">Execute a project script to view docs</span>');
          printLine('<span style="display:inline-block; width:100px; color:#5da9f6; font-weight:bold;">clear</span> <span style="color:#aaa;">Clear the terminal screen</span>');
          printLine('<span style="display:inline-block; width:100px; color:#5da9f6; font-weight:bold;">neofetch</span> <span style="color:#aaa;">Display system info (alias: fetch)</span>');
          printLine('<span style="display:inline-block; width:100px; color:#5da9f6; font-weight:bold;">whoami</span> <span style="color:#aaa;">Print current user</span>');
          printLine('<br>');
          break;
        case 'neofetch':
        case 'fetch':
          if (args.length > 0) {
            printExtraOperandError(cmdLower, args[0]);
            break;
          }
          printLine(renderNeofetch());
          break;
        case 'whoami':
          if (args.length > 0) {
            printExtraOperandError('whoami', args[0]);
            break;
          }
          printTextLine(WHOAMI);
          break;
                case 'ls':
                      if (normalizedTarget) {
                      if (normalizedTarget.startsWith('-')) {
                        const items = Object.keys(fileSystem[currentDir]).map((item) =>
                        fileSystem[currentDir][item] === 'DIR' ? `<span class="folder">${item}/</span>` : item
                        );
                        printLine(items.join('&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;'));
                      } else if (fileSystem[currentDir][normalizedTarget] === 'DIR' && fileSystem[normalizedTarget]) {
                        const subItems = Object.keys(fileSystem[normalizedTarget]).map((item) =>
                        fileSystem[normalizedTarget][item] === 'DIR' ? `<span class="folder">${item}/</span>` : item
                        );
                        printLine(subItems.join('&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;'));
                      } else {
                        printTextLine(`ls: cannot access '${target}': No such directory`, 'error');
                      }
                      } else {
                      const items = Object.keys(fileSystem[currentDir]).map((item) =>
                        fileSystem[currentDir][item] === 'DIR' ? `<span class="folder">${item}/</span>` : item
                      );
                      printLine(items.join('&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;'));
                      }
                      break;
        case 'cd':
          if (args.length > 1) {
            printTextLine('cd: too many arguments', 'error');
            break;
          }
          if (normalizedTarget === '..' || normalizedTarget === '~' || !normalizedTarget) {
            currentDir = 'root';
            if (pathLabel) pathLabel.innerText = formatPrompt('~');
          } else if (currentDir === 'root' && fileSystem.root[normalizedTarget] === 'DIR') {
            currentDir = normalizedTarget;
            if (pathLabel) pathLabel.innerText = formatPrompt(`~/${currentDir}`);
          } else {
            printTextLine(`cd: ${target}: No such directory`, 'error');
          }
          break;
        case 'cat':
          if (args.length === 0) {
            printTextLine('cat: missing file operand', 'error');
            break;
          }
          for (const fileName of args) {
            const entry = fileSystem[currentDir][fileName];
            if (!entry || entry === 'DIR') {
              printTextLine(`cat: ${fileName}: No such file`, 'error');
              continue;
            }
            printFileEntry(fileName, entry as FileEntry);
          }
          break;
        case 'clear':
          if (args.length > 0) {
            printExtraOperandError('clear', args[0]);
            break;
          }
          if (history) history.innerHTML = '';
          scrollToBottom();
          break;
        default:
          // Handle Execution Logic (./script.sh)
          if (cmd.startsWith('./')) {
            if (args.length > 0) {
              printExtraOperandError(cmd, args[0]);
              break;
            }
            const scriptName = cmd.slice(2);
            if (currentDir === 'projects' && fileSystem['projects'][scriptName]) {
              const entry = fileSystem['projects'][scriptName] as FileEntry;
              printTextLine(`Running ${scriptName}... Opening documentation in a new tab.`);
              setTimeout(() => {
                if (entry.kind === 'link') openTerminalLink(entry.value, 'open');
              }, 1000);
            } else if (currentDir === 'contact' && fileSystem['contact'][scriptName]) {
              const entry = fileSystem['contact'][scriptName] as FileEntry;
              const targetLink = entry.kind === 'link' ? entry.value : '';
              if (targetLink.startsWith('mailto:')) {
                printTextLine(`Running ${scriptName}... Opening email client.`);
                openTerminalLink(targetLink, 'navigate');
              } else {
                printTextLine(`Running ${scriptName}... Opening link in a new tab.`);
                openTerminalLink(targetLink, 'open');
              }
            } else {
              printTextLine(`bash: ${cmd}: permission denied or file not found`, 'error');
            }
          } else {
            printTextLine(`${cmd}: command not found`, 'error');
          }
      }
      scrollToBottom();
    }
  });
</script>