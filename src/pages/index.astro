---
// Import custom components
import Terminal from '../components/Terminal.astro';
import InterfaceSwitch from '../components/InterfaceSwitch.astro';
import TopBar from '../components/TopBar.astro';
import NetworkBackground from '../components/NetworkBackground.astro';
import Hero from '../components/Hero.astro';
import Photo from '../assets/Photo.jpg';
// Import global CSS
import '../styles/main.css';

const title = "Pablo Rosi";
const role = "Computer Science Student";
const description = "Bridging the gap between academic theory and production-grade architecture.";
const descriptionFocus = "Focused on scalable systems, security, and automation.";
const metaDescription = "Computer Science student bridging academic theory and production-grade architecture. Focused on scalable systems, security, and automation.";
---


<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet" />
  </head>
  <body class="relative m-0 min-h-svh bg-transparent pb-[env(safe-area-inset-bottom,0px)] font-['Inter',sans-serif] text-[var(--color-white)]">
	<NetworkBackground />
	<TopBar />
    <main id="main-content">
      <Hero
        name={title}
        role={role}
        description={description}
        descriptionFocus={descriptionFocus}
        photo={Photo}
        docsUrl="https://docs.pablorosi.dev"
        social={{
          github: 'https://github.com/pablorosi',
          linkedin: 'https://linkedin.com/in/pablorosi',
          email: 'mailto:hello@pablorosi.com',
        }}
      />

	<InterfaceSwitch class="main-interface">

      <section class="mx-auto mt-20 max-w-[1120px] scroll-mt-20 px-8 first-of-type:mt-8 max-[720px]:my-12 max-[720px]:px-5" data-reveal="up">
        <h2 class="section-heading mb-6 text-[var(--color-white)] projects" data-reveal="up">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-auto text-[var(--color-white)] lucide lucide-cpu"><path d="M12 20v2"/><path d="M12 2v2"/><path d="M17 20v2"/><path d="M17 2v2"/><path d="M2 12h2"/><path d="M2 17h2"/><path d="M2 7h2"/><path d="M20 12h2"/><path d="M20 17h2"/><path d="M20 7h2"/><path d="M7 20v2"/><path d="M7 2v2"/><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="8" y="8" width="8" height="8" rx="1"/></svg>
          Technical Projects
        </h2>

        <div class="content-grid mt-8 grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-6 max-[720px]:grid-cols-1">
          <a
            href="https://docs.pablorosi.dev/cloud-infrastructure/"
            target="_blank" 
            rel="noopener noreferrer"
            class="project-card content-card flex flex-col items-start rounded-xl border border-[var(--color-gray-5)] bg-[var(--card-bg)] p-6 text-inherit no-underline shadow-[0_12px_24px_rgba(0,0,0,0.35)] transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-1 hover:border-[var(--color-accent)] hover:bg-[color-mix(in_srgb,var(--color-accent)_8%,var(--card-bg))] hover:shadow-[0_18px_34px_rgba(0,0,0,0.45)]"
            data-reveal="up"
            data-reveal-delay="100"
          >
            <h3 class="card-title mb-2">Secure Cloud Infrastructure & P2P Routing</h3>
            <p class="card-body mb-4 grow text-[var(--color-gray-3)]">Secure routing, observability, and CI/CD deployment strategies for cloud services..</p>
            <div class="flex flex-wrap gap-2">
              <span class="skill-badge shrink-0 rounded-full border border-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_80%,#1a1a1a_20%)] bg-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_55%,#1a1a1a_45%)] px-[0.6rem] py-[0.3rem] text-[0.72rem] font-bold tracking-[0.08em] text-white uppercase [--skill-accent:#3478eb]">Platform</span>
              <span class="skill-badge shrink-0 rounded-full border border-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_80%,#1a1a1a_20%)] bg-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_55%,#1a1a1a_45%)] px-[0.6rem] py-[0.3rem] text-[0.72rem] font-bold tracking-[0.08em] text-white uppercase [--skill-accent:#ea6b12]">Isolation</span>
            </div>
          </a>

          <a
            href="https://docs.pablorosi.dev/enterprise-homelab/"
            target="_blank" 
            rel="noopener noreferrer"
            class="project-card content-card flex flex-col items-start rounded-xl border border-[var(--color-gray-5)] bg-[var(--card-bg)] p-6 text-inherit no-underline shadow-[0_12px_24px_rgba(0,0,0,0.35)] transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-1 hover:border-[var(--color-accent)] hover:bg-[color-mix(in_srgb,var(--color-accent)_8%,var(--card-bg))] hover:shadow-[0_18px_34px_rgba(0,0,0,0.45)]"
            data-reveal="up"
            data-reveal-delay="200"
          >
            <h3 class="card-title mb-2">Enterprise Local Datacenter</h3>
            <p class="card-body mb-4 grow text-[var(--color-gray-3)]">Building a realistic lab with Cisco switching, Proxmox virtualization, and EVE-NG emulation.</p>
            <div class="flex flex-wrap gap-2">
              <span class="skill-badge shrink-0 rounded-full border border-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_80%,#1a1a1a_20%)] bg-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_55%,#1a1a1a_45%)] px-[0.6rem] py-[0.3rem] text-[0.72rem] font-bold tracking-[0.08em] text-white uppercase [--skill-accent:#2a3788]">Core Ops</span>
              <span class="skill-badge shrink-0 rounded-full border border-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_80%,#1a1a1a_20%)] bg-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_55%,#1a1a1a_45%)] px-[0.6rem] py-[0.3rem] text-[0.72rem] font-bold tracking-[0.08em] text-white uppercase [--skill-accent:#0dad73]">Routing</span>
            </div>
          </a>
        </div>
      </section>

      <section class="mx-auto mt-20 max-w-[1120px] scroll-mt-20 px-8 first-of-type:mt-8 max-[720px]:my-12 max-[720px]:px-5" data-reveal="up">
        <h2 class="section-heading mb-6 text-[var(--color-white)]" data-reveal="up">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-auto text-[var(--color-white)] lucide lucide-code"><path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/></svg>
          Skills & Expertise
        </h2>
        <p class="section-lead mb-6 max-w-full text-[var(--color-gray-3)]" data-reveal="up" data-reveal-delay="50">Practical infrastructure and security skills built through homelab operations, remote hosting, and production-like self-hosted services.</p>

        <div class="content-grid grid grid-cols-2 gap-4 max-[720px]:grid-cols-1 min-[720px]:grid-cols-6 min-[720px]:auto-rows-min min-[720px]:content-start min-[720px]:items-start">
          <article
            class="skill-card relative box-border flex min-h-56 flex-col justify-start gap-4 self-stretch overflow-hidden rounded-2xl border border-[var(--color-gray-5)] bg-[var(--card-bg)] p-6 transition-[border-color] duration-200 hover:border-[var(--color-gray-4)] before:absolute before:inset-x-0 before:top-0 before:h-1 before:w-full before:bg-[var(--skill-accent,var(--color-accent))] before:content-[''] [--skill-accent:#4754c2] min-[720px]:col-span-4 min-[720px]:col-start-1 min-[720px]:row-start-1"
            data-reveal="up"
            data-reveal-delay="100"
          >
            <div class="flex items-start justify-between gap-4 pt-[0.2rem]">
              <h3 class="skill-card-title m-0">Linux Administration</h3>
              <span class="skill-badge shrink-0 rounded-full border border-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_80%,#1a1a1a_20%)] bg-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_55%,#1a1a1a_45%)] px-[0.6rem] py-[0.3rem] text-[0.72rem] font-bold tracking-[0.08em] text-white uppercase">Core Ops</span>
            </div>
            <p class="skill-card-body m-0 text-[var(--color-gray-3)]">Hands-on work with RHEL and Debian, service management, hardening, and permission control.</p>
            <ul class="skill-card-list m-0 grid list-none gap-[0.55rem] p-0 [&_li]:relative [&_li]:pl-4 [&_li]:text-[var(--color-white)] [&_li]:before:absolute [&_li]:before:top-[0.6em] [&_li]:before:left-0 [&_li]:before:size-[0.45rem] [&_li]:before:rounded-full [&_li]:before:bg-[var(--skill-accent,var(--color-accent))] [&_li]:before:shadow-[0_0_0_3px_color-mix(in_srgb,var(--skill-accent,var(--color-accent))_18%,transparent)] [&_li]:before:content-['']">
              <li>RHEL / Debian</li>
              <li>Systemd and users</li>
              <li>Hardening and maintenance</li>
            </ul>
          </article>

          <article
            class="skill-card relative box-border flex min-h-56 flex-col justify-start gap-4 self-stretch overflow-hidden rounded-2xl border border-[var(--color-gray-5)] bg-[var(--card-bg)] p-6 transition-[border-color] duration-200 hover:border-[var(--color-gray-4)] before:absolute before:inset-x-0 before:top-0 before:h-1 before:w-full before:bg-[var(--skill-accent,var(--color-accent))] before:content-[''] [--skill-accent:#3478eb] min-[720px]:col-span-2 min-[720px]:col-start-1 min-[720px]:row-start-2"
            data-reveal="up"
            data-reveal-delay="150"
          >
            <div class="flex items-start justify-between gap-4 pt-[0.2rem]">
              <h3 class="skill-card-title m-0">Infrastructure & Hosting</h3>
              <span class="skill-badge shrink-0 rounded-full border border-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_80%,#1a1a1a_20%)] bg-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_55%,#1a1a1a_45%)] px-[0.6rem] py-[0.3rem] text-[0.72rem] font-bold tracking-[0.08em] text-white uppercase">Platform</span>
            </div>
            <p class="skill-card-body m-0 text-[var(--color-gray-3)]">Designing reliable self-hosted infrastructure.</p>
            <ul class="skill-card-list m-0 grid list-none gap-[0.55rem] p-0 [&_li]:relative [&_li]:pl-4 [&_li]:text-[var(--color-white)] [&_li]:before:absolute [&_li]:before:top-[0.6em] [&_li]:before:left-0 [&_li]:before:size-[0.45rem] [&_li]:before:rounded-full [&_li]:before:bg-[var(--skill-accent,var(--color-accent))] [&_li]:before:shadow-[0_0_0_3px_color-mix(in_srgb,var(--skill-accent,var(--color-accent))_18%,transparent)] [&_li]:before:content-['']">
              <li>Docker and VPS management</li>
              <li>Nginx reverse proxy</li>
              <li>TLS, SSL, and DNS</li>
            </ul>
          </article>

          <article
            class="skill-card relative box-border flex min-h-56 flex-col justify-start gap-4 self-stretch overflow-hidden rounded-2xl border border-[var(--color-gray-5)] bg-[var(--card-bg)] p-6 transition-[border-color] duration-200 hover:border-[var(--color-gray-4)] before:absolute before:inset-x-0 before:top-0 before:h-1 before:w-full before:bg-[var(--skill-accent,var(--color-accent))] before:content-[''] [--skill-accent:#0dad73] min-[720px]:col-span-4 min-[720px]:col-start-3 min-[720px]:row-start-2"
            data-reveal="up"
            data-reveal-delay="200"
          >
            <div class="flex items-start justify-between gap-4 pt-[0.2rem]">
              <h3 class="skill-card-title m-0">Networking</h3>
              <span class="skill-badge shrink-0 rounded-full border border-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_80%,#1a1a1a_20%)] bg-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_55%,#1a1a1a_45%)] px-[0.6rem] py-[0.3rem] text-[0.72rem] font-bold tracking-[0.08em] text-white uppercase">Routing</span>
            </div>
            <p class="skill-card-body m-0 text-[var(--color-gray-3)]">Infrastructure built around segmentation, switching, and addressing fundamentals.</p>
            <ul class="skill-card-list m-0 grid list-none gap-[0.55rem] p-0 [&_li]:relative [&_li]:pl-4 [&_li]:text-[var(--color-white)] [&_li]:before:absolute [&_li]:before:top-[0.6em] [&_li]:before:left-0 [&_li]:before:size-[0.45rem] [&_li]:before:rounded-full [&_li]:before:bg-[var(--skill-accent,var(--color-accent))] [&_li]:before:shadow-[0_0_0_3px_color-mix(in_srgb,var(--skill-accent,var(--color-accent))_18%,transparent)] [&_li]:before:content-['']">
              <li>Cisco IOS</li>
              <li>VLANs and LACP</li>
              <li>Subnetting and ACLs</li>
            </ul>
          </article>

          <article
            class="skill-card relative box-border flex min-h-56 flex-col justify-start gap-4 self-stretch overflow-hidden rounded-2xl border border-[var(--color-gray-5)] bg-[var(--card-bg)] p-6 transition-[border-color] duration-200 hover:border-[var(--color-gray-4)] before:absolute before:inset-x-0 before:top-0 before:h-1 before:w-full before:bg-[var(--skill-accent,var(--color-accent))] before:content-[''] [--skill-accent:#ea6b12] min-[720px]:col-span-2 min-[720px]:col-start-5 min-[720px]:row-start-1"
            data-reveal="up"
            data-reveal-delay="250"
          >
            <div class="flex items-start justify-between gap-4 pt-[0.2rem]">
              <h3 class="skill-card-title m-0">Security & Routing</h3>
              <span class="skill-badge shrink-0 rounded-full border border-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_80%,#1a1a1a_20%)] bg-[color-mix(in_srgb,var(--skill-accent,var(--color-accent))_55%,#1a1a1a_45%)] px-[0.6rem] py-[0.3rem] text-[0.72rem] font-bold tracking-[0.08em] text-white uppercase">Isolation</span>
            </div>
            <p class="skill-card-body m-0 text-[var(--color-gray-3)]">Traffic separation and VPN-based routing for a safer, more controlled homelab stack.</p>
            <ul class="skill-card-list m-0 grid list-none gap-[0.55rem] p-0 [&_li]:relative [&_li]:pl-4 [&_li]:text-[var(--color-white)] [&_li]:before:absolute [&_li]:before:top-[0.6em] [&_li]:before:left-0 [&_li]:before:size-[0.45rem] [&_li]:before:rounded-full [&_li]:before:bg-[var(--skill-accent,var(--color-accent))] [&_li]:before:shadow-[0_0_0_3px_color-mix(in_srgb,var(--skill-accent,var(--color-accent))_18%,transparent)] [&_li]:before:content-['']">
              <li>Gluetun / WireGuard</li>
              <li>Network isolation</li>
              <li>Containerized routing</li>
            </ul>
          </article>
        </div>
      </section>

<section class="mx-auto mt-20 w-full max-w-[1120px] scroll-mt-20 px-8 first-of-type:mt-8 max-[720px]:my-12 max-[720px]:px-5" data-reveal="up">
  <h2 class="section-heading mb-6 text-[var(--color-white)]" data-reveal="up">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-auto text-[var(--color-white)] lucide lucide-graduation-cap"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>
    Certifications
  </h2>

  <p class="section-lead mb-5 text-[var(--color-gray-3)]" data-reveal="up" data-reveal-delay="50">Professional certification roadmap focused on networking and Linux systems administration.</p>

  <div class="relative py-4 max-[720px]:pl-6">
    <div class="absolute top-0 bottom-0 left-1/2 w-0.5 -translate-x-1/2 bg-gradient-to-b from-[var(--color-accent)] to-[var(--color-gray-5)] max-[720px]:left-0 max-[720px]:translate-x-0"></div>

    <article class="relative mb-10 flex items-start last:mb-0" data-reveal="left" data-reveal-delay="100">
      <div class="absolute top-2 left-1/2 z-[1] size-4 -translate-x-1/2 rounded-full bg-[var(--node-color,var(--color-accent))] shadow-[0_0_0_4px_color-mix(in_srgb,var(--node-color,var(--color-accent))_20%,transparent),0_0_12px_color-mix(in_srgb,var(--node-color,var(--color-accent))_30%,transparent)] max-[720px]:left-0 max-[720px]:-translate-x-1/2" style="--node-color: #3478eb"></div>
      <div class="content-card mr-auto w-[calc(50%-2rem)] rounded-xl border border-[var(--color-gray-5)] bg-[var(--card-bg)] p-5 transition-[border-color] duration-200 hover:border-[var(--color-gray-4)] max-[720px]:!mr-0 max-[720px]:!ml-6 max-[720px]:w-[calc(100%-1.5rem)]">
        <div class="mb-[0.35rem] flex items-center justify-between gap-4">
          <h3 class="card-title m-0 text-[var(--color-white)]">CCNA</h3>
          <span class="cert-status rounded-full border-none bg-[#0d3a1f] px-[0.8rem] py-[0.3rem] text-[0.7rem] tracking-[0.05em] whitespace-nowrap text-white uppercase">In Progress</span>
        </div>
        <p class="card-body mb-4 mt-0 text-[var(--color-gray-3)]">Cisco Certified Network Associate</p>
        <div class="flex items-center gap-3">
          <div class="h-2 flex-1 overflow-hidden rounded-[20px] bg-[var(--color-gray-6)]">
            <div class="h-full rounded-[20px] bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-high)]" style="width: 70%"></div>
          </div>
          <span class="min-w-10 shrink-0 text-right text-xs font-semibold text-[var(--color-accent)]">70%</span>
        </div>
      </div>
    </article>

    <article class="relative mb-10 flex items-start last:mb-0" data-reveal="right" data-reveal-delay="200">
      <div class="absolute top-2 left-1/2 z-[1] size-4 -translate-x-1/2 rounded-full bg-[var(--node-color,var(--color-accent))] shadow-[0_0_0_4px_color-mix(in_srgb,var(--node-color,var(--color-accent))_20%,transparent),0_0_12px_color-mix(in_srgb,var(--node-color,var(--color-accent))_30%,transparent)] max-[720px]:left-0 max-[720px]:-translate-x-1/2" style="--node-color: #0dad73"></div>
      <div class="content-card ml-auto w-[calc(50%-2rem)] rounded-xl border border-[var(--color-gray-5)] bg-[var(--card-bg)] p-5 transition-[border-color] duration-200 hover:border-[var(--color-gray-4)] max-[720px]:!mr-0 max-[720px]:!ml-6 max-[720px]:w-[calc(100%-1.5rem)]">
        <div class="mb-[0.35rem] flex items-center justify-between gap-4">
          <h3 class="card-title m-0 text-[var(--color-white)]">RHCSA</h3>
          <span class="cert-status rounded-full border-none bg-[#0d3a1f] px-[0.8rem] py-[0.3rem] text-[0.7rem] tracking-[0.05em] whitespace-nowrap text-white uppercase">In Progress</span>
        </div>
        <p class="card-body mb-4 mt-0 text-[var(--color-gray-3)]">Red Hat Certified System Administrator</p>
        <div class="flex items-center gap-3">
          <div class="h-2 flex-1 overflow-hidden rounded-[20px] bg-[var(--color-gray-6)]">
            <div class="h-full rounded-[20px] bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-high)]" style="width: 20%"></div>
          </div>
          <span class="min-w-10 shrink-0 text-right text-xs font-semibold text-[var(--color-accent)]">20%</span>
        </div>
      </div>
    </article>
  </div>
</section>

	<section class="mx-auto mt-20 max-w-[1120px] scroll-mt-20 px-8 first-of-type:mt-8 max-[720px]:my-12 max-[720px]:px-5" data-reveal="up">
        <h2 class="section-heading mb-6 text-[var(--color-white)]" data-reveal="up">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-auto text-[var(--color-white)] lucide lucide-send"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
          Get in Touch
        </h2>
        <div class="content-grid mt-8 grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-4 max-[720px]:grid-cols-1">
          <a
            href="mailto:hello@pablorosi.com"
            class="contact-link flex items-center justify-center gap-3 rounded-lg border border-[var(--color-gray-5)] bg-[var(--card-bg)] p-4 text-[var(--color-white)] no-underline transition-all duration-200 hover:border-[var(--color-accent)] hover:bg-[color-mix(in_srgb,var(--color-accent)_12%,var(--card-bg))] hover:text-[var(--color-accent)]"
            data-reveal="up"
            data-reveal-delay="100"
          >
            <div>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <span>Email</span>
          </a>
          <a
            href="https://linkedin.com/in/pablorosi"
            target="_blank"
            class="contact-link flex items-center justify-center gap-3 rounded-lg border border-[var(--color-gray-5)] bg-[var(--card-bg)] p-4 text-[var(--color-white)] no-underline transition-all duration-200 hover:border-[var(--color-accent)] hover:bg-[color-mix(in_srgb,var(--color-accent)_12%,var(--card-bg))] hover:text-[var(--color-accent)]"
            data-reveal="up"
            data-reveal-delay="200"
          >
            <div>
